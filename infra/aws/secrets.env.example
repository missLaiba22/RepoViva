# Copy to ~/repoviva-secrets.env on the server, fill in, then run infra/aws/make_env.py.
# No spaces around =. Wrap URLs in single quotes.

# Where it runs (not secret)
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=<paste>
DOMAIN=<paste>

# Neon: the full string from Connect -> Connection string (postgresql://...)
NEON_URL='<paste>'
# Atlas: mongodb+srv://... with <db_password> replaced, brackets included
MONGODB_URI='<paste>'
# The production GitHub OAuth app (callback https://<DOMAIN>/v1/auth/github/callback)
GITHUB_CLIENT_ID=<paste>
GITHUB_CLIENT_SECRET=<paste>
VOYAGE_API_KEY=<paste>
GROQ_API_KEY=<paste>
DEEPGRAM_API_KEY=<paste>

# Optional overrides of the services' defaults
# LLM_MODEL=
# EVAL_LLM_MODEL=
