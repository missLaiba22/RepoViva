ENV=development

# Where the other services live. In docker-compose these become
# http://core-api:8000 and http://repository-service:8001.
CORE_API_BASE_URL=http://127.0.0.1:8000
REPOSITORY_SERVICE_BASE_URL=http://127.0.0.1:8001

# Shared HMAC secret for internal calls (decision 027).
# MUST be identical to core-api's and repository-service's.
INTERNAL_HMAC_SECRET=replace-me-with-a-real-hex-string

# Interview sessions (decision 053). docker-compose runs MongoDB locally.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=repoviva_voice

# LLM (decision 038). Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
LLM_MODEL=groq/qwen/qwen3.8-27b

# Speech (decisions 043, 044). STT reuses GROQ_API_KEY.
# Deepgram key: https://console.deepgram.com ($200 starting credit)
STT_MODEL=groq/whisper-large-v3-turbo
DEEPGRAM_API_KEY=your-deepgram-key
TTS_VOICE=aura-2-thalia-en
MAX_ANSWER_SECONDS=180

# Interview shape (decisions 039, 041, 052)
MAX_QUESTIONS=6
SESSION_START_TIMEOUT_S=10
PLAN_CHUNKS_PER_AREA=2

# SQS and EventBridge (decision 057). Endpoint and keys only for LocalStack; leave unset on AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=repoviva
PLANNING_JOBS_QUEUE_URL=http://127.0.0.1:4566/000000000000/planning-jobs
