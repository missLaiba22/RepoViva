DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
ENV=development
GITHUB_CLIENT_ID=<from step 1>
GITHUB_CLIENT_SECRET=<from step 1>
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback
# The frontend (Vite dev server). Same host as the redirect URI above, so
# the session cookie reaches it. After login the browser lands on /home.
FRONTEND_BASE_URL=http://localhost:5173
COOKIE_SECRET=<first generated string>
TOKEN_ENCRYPTION_KEY=<second generated string>
# SQS (decision 057). Endpoint and keys only for LocalStack; leave unset on AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INGESTION_JOBS_QUEUE_URL=http://127.0.0.1:4566/000000000000/ingestion-jobs
# Where Evaluation Service is reachable — report trigger and report reads.
EVALUATION_SERVICE_BASE_URL=http://127.0.0.1:8003

# Shared HMAC secret for signing internal service-to-service calls.
# MUST be identical to repository-service/.env's INTERNAL_HMAC_SECRET.
# Generate with:  python -c 'import secrets; print(secrets.token_hex(32))'
INTERNAL_HMAC_SECRET=replace-me-with-a-real-hex-string
SESSION_TOKEN_TTL_MINUTES=5