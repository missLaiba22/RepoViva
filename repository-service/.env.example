ENV=development

# Where Core API lives — used when Repository Service fires status callbacks.
# In docker-compose this will be http://core-api:8000; locally it's localhost.
CORE_API_BASE_URL=http://localhost:8000

# Shared HMAC secret used to sign every internal service-to-service HTTP call.
# MUST be identical to core-api/.env's INTERNAL_HMAC_SECRET.
# Generate with:  python -c 'import secrets; print(secrets.token_hex(32))'
INTERNAL_HMAC_SECRET=replace-me-with-a-real-hex-string
# Plain postgresql:// scheme — asyncpg does not accept postgresql+psycopg://.
DATABASE_URL=postgresql://repoviva:repoviva_dev@localhost:5432/repoviva
VOYAGE_API_KEY=vk-your-actual-key-here