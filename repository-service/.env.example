ENV=development

# Shared HMAC secret used to sign every internal service-to-service HTTP call.
# MUST be identical to core-api/.env's INTERNAL_HMAC_SECRET.
# Generate with:  python -c 'import secrets; print(secrets.token_hex(32))'
INTERNAL_HMAC_SECRET=replace-me-with-a-real-hex-string
# Plain postgresql:// scheme — asyncpg does not accept postgresql+psycopg://.
DATABASE_URL=postgresql://repoviva:repoviva_dev@localhost:5432/repoviva
VOYAGE_API_KEY=vk-your-actual-key-here
# Scratch space for clones; each is deleted when ingestion ends.
WORKSPACE_ROOT=./workspace
# CocoIndex's own state DB (which files are already indexed).
COCOINDEX_DB=./workspace/.cocoindex-db

# SQS and EventBridge (decision 057). Endpoint and keys only for LocalStack; leave unset on AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INGESTION_JOBS_QUEUE_URL=http://127.0.0.1:4566/000000000000/ingestion-jobs
EVENT_BUS_NAME=repoviva
