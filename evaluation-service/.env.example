ENV=development

# Where the other services live. In docker-compose these become
# http://voice-service:8002 and http://repository-service:8001.
VOICE_SERVICE_BASE_URL=http://127.0.0.1:8002
REPOSITORY_SERVICE_BASE_URL=http://127.0.0.1:8001

# Shared HMAC secret for internal calls (decision 027).
# MUST be identical to every other service's.
INTERNAL_HMAC_SECRET=replace-me-with-a-real-hex-string

# Plain postgresql:// scheme — asyncpg does not accept postgresql+psycopg://.
DATABASE_URL=postgresql://repoviva:repoviva_dev@localhost:5432/repoviva

# Grading LLM (decision 051). A different model from Voice Service's
# LLM_MODEL, so grading has its own Groq rate-limit bucket.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
EVAL_LLM_MODEL=groq/openai/gpt-oss-120b

# SQS (decision 057). Endpoint and keys only for LocalStack; leave unset on AWS.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INTERVIEW_EVENTS_QUEUE_URL=http://127.0.0.1:4566/000000000000/evaluation-interview-events
REPORT_JOBS_QUEUE_URL=http://127.0.0.1:4566/000000000000/report-jobs
